    "slots_B": "SELECT m.site_id, m.ts, m.kwh, r.p_kwh_inc_vat AS p\nFROM kilowhy.meter_hh m JOIN kilowhy.agile_rates r ON m.ts = r.slot_start\nWHERE m.ts >= timestamp '2026-09-24 00:00:00' AND m.ts < timestamp '2026-10-22 00:00:00'\nORDER BY m.site_id, m.ts",
    "daily_kwh": "SELECT site_id, CAST(ts AS DATE) AS d, SUM(kwh) AS kwh FROM kilowhy.meter_hh\nWHERE ts >= timestamp '2026-08-27 00:00:00' AND ts < timestamp '2026-10-22 00:00:00'\nGROUP BY 1, 2 ORDER BY 1, 2",
    "daily_temp": "SELECT CAST(ts AS DATE) AS d, AVG(temp_c) AS t_mean, COUNT(*) AS n FROM kilowhy.temp_hourly\nWHERE ts >= timestamp '2026-08-27 00:00:00' AND ts < timestamp '2026-10-22 00:00:00'\nGROUP BY 1 ORDER BY 1"
  },
