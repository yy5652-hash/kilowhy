# No secrets here. Real values live in macOS keychain / an untracked .env
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Token is read at runtime from ~/Library/Application Support/ai.meterless.runtime/proxy-token
ZETARIS_URL=http://localhost:8888
# ZETARIS_API_KEY=  (keychain: account kilowhy, service ZETARIS_API_KEY)
# NVIDIA_API_KEY=   (keychain: account kilowhy, service NVIDIA_API_KEY)
# Provider layer (server/src/provider.ts): all optional
# KILOWHY_FALLBACK=off          (disable the labelled NVIDIA-direct fallback; calls then fail if Nightshift is down)
# KILOWHY_METERLESS_PORTS=8088,8090,8787,11434
# KILOWHY_METERLESS_TOKEN_PATH= (default: ~/Library/Application Support/ai.meterless.runtime/proxy-token)
# KILOWHY_LLM_LOG=              (default: data/cache/llm-calls.jsonl, gitignored)
